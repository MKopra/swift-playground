      },
      {
        "comment": "",
        "key": "<key>BGTaskSchedulerPermittedIdentifiers</key>\n<array>\n    <string>%@</string>\n    <string>%@</string>\n</array>",
        "location": {
          "startingColumn": 26,
          "startingLine": 500
        }
      },
      {
        "comment": "",
        "key": "BGTaskScheduler.shared.register(\n    forTaskWithIdentifier: identifier,\n    using: nil\n) { task in\n    self.handleTask(task)\n}",
        "location": {
          "startingColumn": 26,
          "startingLine": 511
        }
      },
      {
        "comment": "",
        "key": "let request = BGAppRefreshTaskRequest(\n    identifier: identifier\n)\nrequest.earliestBeginDate = Date(\n    timeIntervalSinceNow: 15 * 60\n)\ntry BGTaskScheduler.shared.submit(request)",
        "location": {
          "startingColumn": 26,
          "startingLine": 523
